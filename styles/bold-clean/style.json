{
  "output": {
    "width": 2160,
    "height": 3840,
    "fps": 30,
    "fit": "crop"
  },
  "transition": {
    "type": "cut"
  },
  "motion": {
    "type": "zoom_in",
    "amount": 0.06
  },
  "captions": {
    "words_per_line": 3,
    "max_gap": 0.45,
    "style": {
      "mode": "html",
      "template": "box-pop",
      "accent": "#FFFFFF",
      "y": 0.7,
      "ink": "#111111"
    },
    "sfx": {
      "line": {
        "sound": "swish",
        "volume": 0.08
      },
      "big": {
        "sound": "whoosh_fast",
        "volume": 0.11
      }
    }
  },
  "type_presets": {
    "label": {
      "font": "Poppins SemiBold",
      "italic": false,
      "bold": false,
      "size": 3.6,
      "color": "white"
    },
    "small": {
      "font": "Poppins SemiBold",
      "italic": false,
      "bold": false,
      "size": 4.2,
      "lowercase": true
    },
    "headline": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "white"
    },
    "headline_accent": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "#FFD400"
    },
    "accent": {
      "font": "Instrument Serif",
      "italic": true,
      "bold": false,
      "size": 6,
      "lowercase": true,
      "color": "#FFD400"
    },
    "serif": {
      "font": "Instrument Serif",
      "italic": true,
      "bold": false,
      "size": 12
    },
    "heavy": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "#FFD400"
    }
  },
  "text": {
    "font": "Poppins ExtraBold",
    "bold": false,
    "size": 5.5,
    "color": "white",
    "outline": 0.4,
    "shadow": 3,
    "shadow_alpha": 90,
    "animation": "pop",
    "y": 0.5
  },
  "lower_third": {
    "font": "Poppins SemiBold",
    "color": "#111111"
  },
  "overlay": {
    "animation": "pop",
    "width": 0.22
  },
  "look": {
    "cinematic": 0.6,
    "contrast": 1.06,
    "saturation": 1.22,
    "warmth": 0.03,
    "sharpen": 0.6,
    "vignette": 0.45,
    "grain": 2,
    "brightness": 0.03
  },
  "music": {
    "volume": 0.15,
    "duck": true
  },
  "loudness": -14,
  "quality": {
    "crf": 17,
    "preset": "slow"
  },
  "safe": {
    "top": 0.12,
    "bottom": 0.25,
    "left": 0.06,
    "right": 0.14
  },
  "glass": {
    "widget": {
      "tint_color": "#FFFFFF",
      "tint": 0.62,
      "border_color": "#FFFFFF",
      "border": 0.7,
      "border_width": 2,
      "radius": 0.2,
      "blur": 26,
      "brightness": 0.05,
      "saturation": 1.0,
      "text_color": "#111111",
      "value_font": "Anton",
      "w": 0.5,
      "h": 0.19,
      "value_size": 0.46,
      "pad": 0.12,
      "sub_font": "Instrument Serif",
      "sub_italic": true,
      "sub_size": 1.5,
      "sub_color": "#4A4A4A"
    },
    "widget_dark": {
      "tint_color": "#1C1C1E",
      "tint": 0.34,
      "border_color": "#FFFFFF",
      "border": 0.42,
      "border_width": 2,
      "radius": 0.2,
      "blur": 26,
      "brightness": -0.05,
      "saturation": 1.1,
      "value_font": "Inter Tight Black",
      "w": 0.5,
      "h": 0.15,
      "value_size": 0.38,
      "sub_font": "Instrument Serif",
      "sub_italic": true,
      "sub_size": 1.5,
      "sub_color": "#EDE6D6"
    },
    "plain": {
      "radius": 0.5,
      "tint_color": "#A7ADB4",
      "tint": 0.22,
      "border_color": "#FFFFFF",
      "border": 0.55,
      "border_width": 2,
      "blur": 26
    }
  }
}
