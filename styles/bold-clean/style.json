{
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "fit": "crop"
  },
  "transition": {
    "type": "cut"
  },
  "motion": {
    "type": "zoom_in",
    "amount": 0.06
  },
  "captions": {
    "words_per_line": 3,
    "max_gap": 0.45,
    "style": {
      "mode": "html",
      "template": "box-pop",
      "accent": "#FFD400",
      "y": 0.68
    },
    "sfx": {
      "big": {
        "sound": "swish",
        "volume": 0.16
      }
    }
  },
  "type_presets": {
    "label": {
      "font": "Poppins SemiBold",
      "italic": false,
      "bold": false,
      "size": 3.6,
      "color": "white"
    },
    "small": {
      "font": "Poppins SemiBold",
      "italic": false,
      "bold": false,
      "size": 4.2,
      "lowercase": true
    },
    "headline": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "white"
    },
    "headline_accent": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "#FFD400"
    },
    "accent": {
      "font": "Instrument Serif",
      "italic": true,
      "bold": false,
      "size": 6,
      "lowercase": true,
      "color": "#FFD400"
    },
    "serif": {
      "font": "Instrument Serif",
      "italic": true,
      "bold": false,
      "size": 12
    },
    "heavy": {
      "font": "Oswald",
      "italic": false,
      "bold": true,
      "size": 9,
      "uppercase": true,
      "color": "#FFD400"
    }
  },
  "text": {
    "font": "Poppins ExtraBold",
    "bold": false,
    "size": 5.5,
    "color": "white",
    "outline": 0.4,
    "shadow": 3,
    "shadow_alpha": 90,
    "animation": "pop",
    "y": 0.5
  },
  "lower_third": {
    "font": "Poppins SemiBold",
    "color": "#111111"
  },
  "overlay": {
    "animation": "pop",
    "width": 0.22
  },
  "look": {
    "contrast": 1.08,
    "saturation": 1.12,
    "warmth": 0.04,
    "sharpen": 0.45,
    "vignette": 0.5,
    "grain": 4
  },
  "music": {
    "volume": 0.15,
    "duck": true
  },
  "loudness": -14,
  "quality": {
    "crf": 17,
    "preset": "slow"
  },
  "safe": {
    "top": 0.12,
    "bottom": 0.25,
    "left": 0.06,
    "right": 0.14
  }
}