{
  "output": { "width": 1080, "height": 1920, "fps": 30, "fit": "crop" },
  "transition": { "type": "cut" },
  "motion": { "type": "zoom_in", "amount": 0.06 },
  "captions": {
    "words_per_line": 3,
    "max_gap": 0.45,
    "style": {
      "mode": "kinetic",
      "font": "Poppins SemiBold", "bold": false, "italic": false, "lowercase": true,
      "size": 4.0, "color": "white", "y": 0.68,
      "outline": 0.55, "outline_color": "#000000", "outline_alpha": 40, "glow": 7, "shadow": 0,
      "kinetic": {
        "small": { "font": "Poppins SemiBold", "size": 4.8, "color": "white" },
        "big": [
          { "font": "Instrument Serif", "italic": true, "size": 11.5, "color": "white" },
          { "font": "Anton", "size": 8.6, "color": "#FFD400", "uppercase": true },
          { "font": "Montserrat Black", "size": 8.2, "color": "white", "uppercase": true }
        ],
        "min_len": 4,
        "no_big_scale": 1.25
      }
    },
    "sfx": {
      "line": { "sound": "tick", "volume": 0.22 },
      "big": { "sound": "whoosh_fast", "volume": 0.12 }
    }
  },
  "type_presets": {
    "small": { "font": "Poppins SemiBold", "italic": false, "bold": false, "size": 4.2, "lowercase": true },
    "serif": { "font": "Instrument Serif", "italic": true, "bold": false, "size": 12 },
    "heavy": { "font": "Anton", "italic": false, "bold": false, "size": 9, "uppercase": true, "color": "#FFD400" }
  },
  "text": {
    "font": "Poppins ExtraBold", "bold": false, "size": 5.5, "color": "white",
    "outline": 0.4, "shadow": 3, "shadow_alpha": 90, "animation": "pop", "y": 0.5
  },
  "lower_third": { "font": "Poppins SemiBold", "color": "#111111" },
  "overlay": { "animation": "pop", "width": 0.22 },
  "look": { "contrast": 1.08, "saturation": 1.15, "warmth": 0.04, "sharpen": 0.5, "vignette": 0.5 },
  "music": { "volume": 0.15, "duck": true },
  "loudness": -14
}
